# ========================================
# CONFIGURAÇÕES DO PROJETO BOT IGREJA
# ========================================

# PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=sua_senha_postgresql_aqui
POSTGRES_DB=evolution
N8N_DB=n8n

# Evolution API
EVOLUTION_API_KEY=sua_chave_api_secreta_aqui
# Local:      http://localhost:8080
# Produção:   https://api.gracaepaz.org.br
SERVER_URL=http://localhost:8080

# N8N
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=sua_senha_n8n_aqui
# Local:      http://localhost:5678
# Produção:   https://n8n.gracaepaz.org.br
N8N_WEBHOOK_URL=http://localhost:5678

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=sua_senha_pgadmin_aqui

# ========================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha com suas credenciais reais
# 3. NUNCA commite o arquivo .env no Git
# ========================================
