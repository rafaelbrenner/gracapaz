# ========================================
# CONFIGURAÇÕES DO PROJETO BOT IGREJA
# ========================================

# PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=sua_senha_postgresql_aqui
POSTGRES_DB=evolution
N8N_DB=n8n

# WhatsApp Cloud API (Meta — canal oficial)
# Veja META_SETUP.md para obter estes valores no painel da Meta.
GRAPH_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui   # tela WhatsApp > API Setup
WHATSAPP_WABA_ID=seu_waba_id_aqui                    # WhatsApp Business Account ID
WHATSAPP_TOKEN=seu_token_permanente_aqui             # token do System User (não expira)
WHATSAPP_VERIFY_TOKEN=uma_string_aleatoria_secreta   # igual à cadastrada no webhook da Meta

# N8N
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=sua_senha_n8n_aqui
# Local:      http://localhost:5678
# Produção:   https://n8n.gracaepazdf.org.br
N8N_WEBHOOK_URL=http://localhost:5678

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=sua_senha_pgadmin_aqui

# ========================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha com suas credenciais reais
# 3. NUNCA commite o arquivo .env no Git
# ========================================
